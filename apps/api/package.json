{
  "name": "@request.news/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "codegen": "wrangler types --strict-vars=false",
    "dev": "wrangler dev --port 8787",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dry-run": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "seed:local": "wrangler d1 execute DB --local --file=../../packages/db/seed/dev-seed.sql"
  },
  "dependencies": {
    "@request.news/db": "workspace:*",
    "@request.news/shared": "workspace:*",
    "hono": "catalog:",
    "@hono/zod-openapi": "catalog:",
    "zod": "catalog:",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
